{
    "logger.plugin.level": "INFO",

    "editor.auto_complete": true,
    "editor.highlight_references": true,

    // How long the caret must rest, in milliseconds, before references are highlighted.
    "editor.highlight_references_delay": 300,
    "editor.show_hover": true,
    "editor.format_on_save": false,

    // How long saving waits for the document to be formatted, in milliseconds.
    // If it takes longer, the document is saved as is.
    "editor.format_on_save_timeout": 1000,

    "servers": []
}
